# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (leave empty or default for automatic local in-memory fallback during dev)
MONGODB_URI=mongodb://localhost:27017/couplewalah

# JWT Secret for Authentication
JWT_SECRET=couplewalah_development_super_secret_jwt_key_2026

# Razorpay Test Credentials (Leave empty to use built-in Safe Development Simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (Optional - local fallback supported)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider (Optional - dev logs to console)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=support@couplewalah.com
